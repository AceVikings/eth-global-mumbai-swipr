{
  "name": "swipr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api": "node --env-file-if-exists=.env --import tsx server/main.ts",
    "worker": "node --env-file-if-exists=.env --import tsx server/worker.ts",
    "doctor": "node --env-file-if-exists=.env --import tsx scripts/doctor.ts",
    "dev:stack": "node scripts/dev-stack.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "demo:check": "node scripts/demo-check.mjs"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "@privy-io/react-auth": "3.51.3",
    "@solana-program/system": "0.10.0",
    "@stripe/stripe-js": "1.54.2",
    "jose": "6.1.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "tailwindcss": "4.1.17",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.18.0 <23"
  }
}
