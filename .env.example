# Only VITE_ values are exposed to the browser. Never prefix secrets with VITE_.
VITE_PRIVY_APP_ID=
VITE_API_URL=
PORT=8787
APP_MODE=live
# Server audience-checked wallet signatures for bot profiles. Production requires HTTPS origins.
BOT_AUTH_AUDIENCE=http://localhost:5173
PUBLIC_API_URL=http://localhost:8787
# Private Cloud Run worker origin in production; loopback for local development.
WORKER_URL=http://127.0.0.1:8788
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Arkiv is the only store. Empty ARKIV_RPC_URL = SDK default (Rabdi); ARKIV_ACCESS_KEY optional.
ARKIV_RPC_URL=
ARKIV_ACCESS_KEY=
# Public address of the dedicated engine relayer (the canonical writer). The key is worker-only.
ARKIV_WRITER_ADDRESS=
ARKIV_RELAYER_PK=
# Separate funded account for permissionless journal renewal; never reuse the engine writer.
ARKIV_MAINTAINER_PK=
ARKIV_ENGINE_STREAM=swipr-engine-v1
ARKIV_CONFIRMATIONS=2
FLASH_KEY_EXEC=
BASE_RPC=
SEPOLIA_RPC=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=
PRIVY_KEY_QUORUM_ID=
PRIVY_AUTHORIZATION_PRIVATE_KEY=
BEE_GATEWAY_URL=
BEE_GATEWAY_2_URL=
BEE_URL=
SWARM_BATCH_ID=
