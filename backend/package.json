{
  "name": "swipr-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --env-file-if-exists=.env --import tsx --watch main.ts",
    "api": "node --env-file-if-exists=../.env --env-file-if-exists=.env --import tsx main.ts",
    "start": "npm run api",
    "worker": "node --env-file-if-exists=../.env --env-file-if-exists=.env --import tsx worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "express": "5.2.1",
    "jose": "6.1.3",
    "tsx": "4.20.6",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.18.0 <23"
  }
}
